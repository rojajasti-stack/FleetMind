# ==============================================================================
# FleetMind AI — Client Environment Configuration Template
# ==============================================================================
# In Vite, client-accessible environment variables MUST start with "VITE_"
#
# IMPORTANT SECURITY RULES:
# - NEVER put "service_role" keys or database root passwords in frontend files.
# - Only provide your Project URL and the public "anon" publishable key.
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API -> Project URL)
# Example: https://xyzcompanyproject.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (from Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon/public)
VITE_SUPABASE_ANON_KEY=your-actual-anon-publishable-key-here
